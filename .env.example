# Copy to .env and change every value before running `docker compose up`.
POSTGRES_PASSWORD=change-me
# HMAC key for signing access tokens: at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Seed demo users and ~90 days of history on first start (only if the database is empty)
DEMO_DATA_ENABLED=true
SWAGGER_UI_ENABLED=true
